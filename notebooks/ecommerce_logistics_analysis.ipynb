## 11. Seller State Segmentation — K-Means

Instead of manually defining "good" and "bad" states, K-Means finds the natural performance groupings. This reveals structural patterns that manual thresholds would miss.

from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score
from sklearn.preprocessing import StandardScaler

# Build state-level performance metrics
state_performance = (
    olist.groupby('seller_state')
    .agg(
        total_orders  = ('order_id',            'count'),
        on_time_rate  = ('on_time',             'mean'),
        avg_delay     = ('delivery_delay_days', 'mean'),
        avg_review    = ('review_score',        'mean'),
        total_revenue = ('total_revenue',       'sum')
    )
    .reset_index()
    .query('total_orders >= 100')
)

# Cluster by 3 performance dimensions
cluster_input = state_performance[['on_time_rate', 'avg_delay', 'avg_review']].copy()
state_scaler  = StandardScaler()
cluster_scaled = state_scaler.fit_transform(cluster_input)

# Find optimal k using silhouette score
silhouette_scores = {}
for k in range(2, 6):
    km  = KMeans(n_clusters=k, random_state=42, n_init=10)
    lbl = km.fit_predict(cluster_scaled)
    silhouette_scores[k] = silhouette_score(cluster_scaled, lbl)

optimal_k = max(silhouette_scores, key=silhouette_scores.get)
print(f"Silhouette scores: {silhouette_scores}")
print(f"Optimal clusters: {optimal_k}")

final_km = KMeans(n_clusters=optimal_k, random_state=42, n_init=10)
state_performance['cluster'] = final_km.fit_predict(cluster_scaled)

# Label clusters by on-time rate ranking
cluster_on_time_rank = (
    state_performance.groupby('cluster')['on_time_rate']
    .mean().rank(ascending=False).astype(int))
tier_labels = {1:'Top Performer', 2:'Average', 3:'Needs Improvement', 4:'Critical'}
state_performance['performance_tier'] = state_performance['cluster'].map(
    {c: tier_labels.get(cluster_on_time_rank[c], 'Other')
     for c in state_performance['cluster'].unique()})

# Summary
tier_summary = (
    state_performance.groupby('performance_tier')
    .agg(state_count=('seller_state','count'),
         avg_on_time =('on_time_rate', 'mean'),
         avg_delay   =('avg_delay',    'mean'),
         avg_review  =('avg_review',   'mean'),
         total_revenue=('total_revenue','sum'))
    .reset_index()
    .sort_values('avg_on_time', ascending=False)
)
tier_summary['avg_on_time'] = (tier_summary['avg_on_time']*100).round(1)
tier_summary['avg_delay']   = tier_summary['avg_delay'].round(1)
tier_summary['avg_review']  = tier_summary['avg_review'].round(2)

print()
print("Performance tiers:")
print(tier_summary.to_string(index=False))
print()
for tier in tier_summary['performance_tier']:
    states = state_performance[state_performance['performance_tier']==tier]['seller_state'].tolist()
    print(f"{tier}: {', '.join(states)}")

Image('chart8_seller_segmentation.png')
## 12. Time Series Analysis
# Monthly aggregation
monthly_trends = (
    olist.groupby('order_month')
    .agg(orders      =('order_id',    'count'),
         revenue     =('total_revenue','sum'),
         on_time_pct =('on_time',     'mean'),
         avg_review  =('review_score','mean'))
    .reset_index()
    .sort_values('order_month')
)
monthly_trends = monthly_trends[monthly_trends['orders'] > 100].reset_index(drop=True)
monthly_trends['rolling_trend'] = monthly_trends['orders'].rolling(window=3, center=True).mean()
monthly_trends['month_number']  = pd.to_datetime(monthly_trends['order_month']).dt.month

# Key metrics
first_month = monthly_trends['orders'].iloc[0]
last_month  = monthly_trends['orders'].iloc[-1]
growth_pct  = (last_month / first_month - 1) * 100

review_slope = np.polyfit(range(len(monthly_trends)), monthly_trends['avg_review'], 1)[0]
quality_trend = "improving" if review_slope > 0 else "declining"

print(f"Order growth: {first_month:,} → {last_month:,} ({growth_pct:.0f}%)")
print(f"Peak month  : {monthly_trends.loc[monthly_trends['orders'].idxmax(),'order_month']} ({monthly_trends['orders'].max():,} orders)")
print(f"Quality trend: {quality_trend} ({review_slope:.4f} per month)")
print(f"Revenue vs on-time correlation: {monthly_trends['revenue'].corr(monthly_trends['on_time_pct']):.3f}")

